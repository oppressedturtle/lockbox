# LockBox — server environment. Copy to .env and adjust for local dev:
#   cp .env.example .env
# These defaults match the docker-compose Postgres service.

# Postgres connection string. The server only ever reads/writes ciphertext.
DATABASE_URL="postgresql://lockbox:lockbox@localhost:5432/lockbox?schema=public"

NODE_ENV="development"

# Secret for signing session tokens (HMAC) + deriving the decoy login salt.
# Generate a strong value, e.g.:  openssl rand -base64 48
# Must be at least 32 characters. Never commit the real value.
SESSION_SECRET="dev-only-change-me-please-32chars-minimum-secret"
